YOUGYM_INTEGRATION_MODE=mock
YOUGYM_INTEGRATION_TEST_TOKEN=local-only
YOUGYM_ADMIN_TEST_TOKEN=local-admin
YOUGYM_ADMIN_REGISTRATION_ENABLED=false
YOUGYM_ADMIN_REGISTRATION_INVITE_CODE=

# Leave these defaults for local H2. Set a MySQL URL in staging/production.
SPRING_DATASOURCE_URL=jdbc:h2:mem:yougym;MODE=MySQL;DB_CLOSE_DELAY=-1
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER=org.h2.Driver

# Set mode=aliyun only after all provider values are configured.
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION=cn-hangzhou
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

ALIYUN_EMAIL_ACCESS_KEY_ID=
ALIYUN_EMAIL_ACCESS_KEY_SECRET=
ALIYUN_EMAIL_ENDPOINT=dm.aliyuncs.com
ALIYUN_EMAIL_ACCOUNT_NAME=
ALIYUN_EMAIL_TAG_NAME=
ALIYUN_EMAIL_REGISTER_TEMPLATE_ID=
ALIYUN_EMAIL_LOGIN_TEMPLATE_ID=

ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_REGION=cn-hangzhou
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_KEY_PREFIX=you-gym/integration-tests
ALIYUN_OSS_SIGNED_URL_MINUTES=15
